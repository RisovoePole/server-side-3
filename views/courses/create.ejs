<%- include('../partials/header') %>

<main class="container page">
  <section class="panel form-panel">
    <h1>Добавить новый курс</h1>
    <p class="subtitle">Заполните данные дисциплины</p>

    <% if (errors && errors.length) { %>
      <div class="alert alert-error" role="alert">
        <strong>Проверьте правильность заполнения:</strong>
        <ul>
          <% errors.forEach(function (error) { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/courses" class="course-form">
      <div class="field">
        <label for="title">Название дисциплины</label>
        <input type="text" id="title" name="title" value="<%= formData.title || '' %>" placeholder="Например: Web Development">
      </div>
      <div class="field">
        <label for="teacher">Преподаватель</label>
        <input type="text" id="teacher" name="teacher" value="<%= formData.teacher || '' %>" placeholder="Имя и фамилия">
      </div>
      <div class="form-row">
        <div class="field field-small">
          <label for="credits">Количество кредитов</label>
          <input type="number" id="credits" name="credits" min="1" value="<%= formData.credits || '' %>">
        </div>
        <div class="field field-small">
          <label for="semester">Семестр (1–8)</label>
          <input type="number" id="semester" name="semester" min="1" max="8" value="<%= formData.semester || '' %>">
        </div>
      </div>
      <div class="field">
        <label for="description">Описание</label>
        <textarea id="description" name="description" rows="4" placeholder="Краткое описание дисциплины"><%= formData.description || '' %></textarea>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Сохранить курс</button>
        <a class="btn btn-ghost" href="/courses">Отмена</a>
      </div>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
