<%- include('../partials/header') %>

<main class="container page">
  <section class="page-heading">
    <div>
      <h1>Система управления учебными курсами</h1>
      <p class="subtitle">Просмотр, поиск и управление учебными дисциплинами</p>
    </div>
    <a class="btn btn-primary" href="/courses/new">+ Новый курс</a>
  </section>

  <section class="panel">
    <h2 class="panel-title">Поиск и фильтр</h2>
    <form class="filter-form" method="GET" action="/courses">
      <div class="form-row">
        <div class="field">
          <label for="search">Поиск (название или преподаватель)</label>
          <input type="text" id="search" name="search" value="<%= search %>" placeholder="Например: node или Ivan">
        </div>
        <div class="field field-small">
          <label for="semester">Семестр</label>
          <select id="semester" name="semester">
            <option value="">Все семестры</option>
            <% for (let s = 1; s <= 8; s++) { %>
              <option value="<%= s %>" <%= Number(semester) === s ? 'selected' : '' %>><%= s %></option>
            <% } %>
          </select>
        </div>
        <div class="filter-actions">
          <button class="btn btn-secondary" type="submit">Применить</button>
          <a class="btn btn-ghost" href="/courses">Сбросить</a>
        </div>
      </div>
    </form>
  </section>

  <section class="panel">
    <div class="table-head">
      <h2 class="panel-title">Курсы</h2>
      <span class="badge">Всего: <%= total %></span>
    </div>

    <% if (courses.length) { %>
      <div class="table-wrap">
        <table class="course-table">
          <thead>
            <tr>
              <th>Название</th>
              <th>Преподаватель</th>
              <th>Кредиты</th>
              <th>Семестр</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach(function (course) { %>
              <tr>
                <td class="course-title"><%= course.title %></td>
                <td><%= course.teacher %></td>
                <td><%= course.credits %></td>
                <td><%= course.semester %></td>
                <td>
                  <div class="row-actions">
                    <a class="btn btn-view" href="/courses/<%= course.id %>">Просмотр</a>
                    <a class="btn btn-edit" href="/courses/<%= course.id %>/edit">Редактировать</a>
                    <form class="inline-form" action="/courses/<%= course.id %>/delete" method="POST" onsubmit="return confirm('Удалить этот курс?')">
                      <button class="btn btn-delete" type="submit">Удалить</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="result-count">Показано курсов: <%= courses.length %></p>
    <% } else { %>
      <p class="empty-state">Курсы не найдены</p>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
